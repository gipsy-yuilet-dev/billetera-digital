# ============================================
# ALKE WALLET - Git Ignore
# ============================================

# Archivos de configuración con datos sensibles
.env
.env.local
.env.production

# Datos de usuarios (localStorage se guarda en el navegador, pero por si acaso)
users.json
*.db
*.sqlite

# Archivos temporales
*.tmp
*.temp
*.log
*.cache

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Carpetas de IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Node modules (si en el futuro agregas Node.js)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de respaldo
*.bak
*.backup
*~

# Archivos de credenciales locales
UsuarioWallet.txt
credentials.txt
passwords.txt

# Archivos de configuración local
config.local.js
constants.local.js

# Carpeta de builds (si implementas build process)
dist/
build/

# Coverage reports
coverage/
*.coverage

# Dependencias
vendor/
