# ============================================
# ALKE WALLET - Configuración de Entorno
# ============================================
# 
# Este es un archivo de ejemplo de configuración.
# Copia este archivo como .env y configura tus propios valores.
# NUNCA subas el archivo .env a GitHub - ya está en .gitignore
#

# ============================================
# USUARIOS DE PRUEBA PARA DESARROLLO LOCAL
# ============================================
# Estos usuarios son solo para desarrollo local
# NO incluyas estas credenciales en producción
#
# Usuario 1:
# Email: usuario1@ejemplo.com
# Password: prueba123
# Nombre: Usuario Demo 1
#
# Usuario 2:
# Email: usuario2@ejemplo.com
# Password: prueba456
# Nombre: Usuario Demo 2

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================

# Presupuesto inicial por defecto (en la moneda del usuario)
DEFAULT_INITIAL_BUDGET=10000

# Moneda por defecto
DEFAULT_CURRENCY=USD

# ============================================
# TASAS DE CAMBIO
# ============================================
# En producción, estas deberían venir de una API externa
# Ejemplo: exchangerate-api.com, fixer.io, etc.

EXCHANGE_RATE_USD_TO_CLP=920
EXCHANGE_RATE_USD_TO_EUR=0.92
EXCHANGE_RATE_CLP_TO_USD=0.0011
EXCHANGE_RATE_CLP_TO_EUR=0.0010
EXCHANGE_RATE_EUR_TO_USD=1.09
EXCHANGE_RATE_EUR_TO_CLP=1000

# ============================================
# CONFIGURACIÓN DE DESARROLLO
# ============================================

# Modo de desarrollo (true para mostrar logs adicionales)
DEV_MODE=true

# Habilitar usuarios de prueba automáticos
ENABLE_TEST_USERS=false

# ============================================
# CONFIGURACIÓN DE ALMACENAMIENTO
# ============================================

# Prefijo para las claves de localStorage
STORAGE_PREFIX=alke_wallet_

# Versión de la base de datos local
DB_VERSION=1.0

# ============================================
# LÍMITES Y VALIDACIONES
# ============================================

# Longitud mínima de contraseña
MIN_PASSWORD_LENGTH=6

# Presupuesto inicial mínimo
MIN_INITIAL_BUDGET=10000

# Número máximo de contactos frecuentes
MAX_QUICK_CONTACTS=4

# Número máximo de transacciones recientes en dashboard
MAX_RECENT_TRANSACTIONS=5

# ============================================
# API EXTERNA (Opcional - para producción)
# ============================================

# API Key para servicio de tasas de cambio
# EXCHANGE_RATE_API_KEY=tu_api_key_aqui

# URL de la API de tasas de cambio
# EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/

# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# 1. Este archivo (.env.example) SÍ debe subirse a GitHub
# 2. El archivo .env NO debe subirse a GitHub (está en .gitignore)
# 3. Cada desarrollador debe crear su propio archivo .env
# 4. Para producción, usa variables de entorno del servidor
# 5. Mantén las credenciales seguras y privadas
#
